@model QuizTakeViewModel
@{
    ViewData["Title"] = Model.Quiz.Title;
    var previous = ViewData["Answers"] as Dictionary<int, string> ?? new Dictionary<int, string>();
    var letters = new[] { "A", "B", "C", "D" };
}

<section class="page-header">
    <div class="container narrow">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Member" asp-action="Learn" asp-route-id="@Model.Quiz.CourseId">@Model.Quiz.CourseTitle</a>
        </nav>
        <h1>@Model.Quiz.Title</h1>
        @if (!string.IsNullOrEmpty(Model.Quiz.Description))
        {
            <p class="page-sub">@Model.Quiz.Description</p>
        }
        <p>@Model.Questions.Count questions. You need <strong>@Model.Quiz.PassPercent%</strong> to pass. You can retake it as often as you like.</p>
    </div>
</section>

<section class="section section-tight">
    <div class="container narrow">
        <form asp-action="Take" asp-route-id="@Model.Quiz.QuizId" method="post" id="quizForm" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <div class="alert alert-error" id="quizClientError" hidden></div>

            <div class="quiz-progress" aria-live="polite">
                <progress id="quizProgress" max="@Model.Questions.Count" value="@previous.Count"></progress>
                <span><span id="answeredCount">@previous.Count</span> of @Model.Questions.Count answered</span>
            </div>

            @for (var i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                previous.TryGetValue(q.QuestionId, out var chosen);
                <fieldset class="question" id="q-@q.QuestionId">
                    <legend><span class="q-num">Question @(i + 1)</span> @q.QuestionText</legend>
                    @foreach (var letter in letters)
                    {
                        var inputId = $"q{q.QuestionId}{letter}";
                        <label class="option" for="@inputId">
                            <input type="radio" id="@inputId" name="answers[@q.QuestionId]" value="@letter"
                                   required @(chosen == letter ? "checked" : "") />
                            <span class="option-letter">@letter</span>
                            <span>@q.OptionText(letter)</span>
                        </label>
                    }
                </fieldset>
            }

            <div class="quiz-actions">
                <button type="submit" class="btn btn-primary">Submit answers</button>
                <a class="btn btn-ghost" asp-controller="Member" asp-action="Learn" asp-route-id="@Model.Quiz.CourseId">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/quiz.js" asp-append-version="true"></script>
}

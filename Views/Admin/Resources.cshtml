@model List<Resource>
@{
    ViewData["Title"] = "Manage resources";
    var courses = ViewBag.Courses as List<Course> ?? new();
    var selected = ViewData["CourseId"] as int?;
}

<div class="container admin-layout">
    <partial name="_AdminNav" />
    <div class="admin-main">
        <header class="admin-head with-action">
            <div>
                <h1>Resources</h1>
                <p>Videos, PDFs, external links, notes, images and audio shown on each course's learning page.</p>
            </div>
            <a class="btn btn-primary" asp-action="CreateResource" asp-route-courseId="@selected">Add resource</a>
        </header>

        <form method="get" asp-action="Resources" class="toolbar">
            <label for="courseId" class="visually-hidden">Course</label>
            <select id="courseId" name="courseId" onchange="this.form.submit()">
                <option value="">All courses</option>
                @foreach (var c in courses)
                {
                    <option value="@c.CourseId" selected="@(c.CourseId == selected)">@c.Title</option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-small">Filter</button></noscript>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th scope="col">#</th><th scope="col">Title</th><th scope="col">Type</th><th scope="col">Course</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-cell">No resources yet.</td></tr>
                    }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.SortOrder</td>
                            <td><strong>@r.Title</strong><br /><a class="text-link small" href="@r.Url" target="_blank" rel="noopener">@(r.Url.Length > 50 ? r.Url.Substring(0, 47) + "…" : r.Url)</a></td>
                            <td><span class="res-type res-@r.Type.ToLower()">@MediaHelper.TypeIcon(r.Type) @r.Type</span></td>
                            <td>@r.CourseTitle</td>
                            <td class="actions">
                                <a class="text-link" asp-action="EditResource" asp-route-id="@r.ResourceId">Edit</a>
                                <form asp-action="DeleteResource" asp-route-id="@r.ResourceId" method="post" data-confirm="Delete the resource @r.Title?">
                                    <button type="submit" class="link-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

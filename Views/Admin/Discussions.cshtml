@model List<DiscussionPost>
@{
    ViewData["Title"] = "Moderate discussions";
}

<div class="container admin-layout">
    <partial name="_AdminNav" />
    <div class="admin-main">
        <header class="admin-head">
            <h1>Discussions</h1>
            <p>All threads across every course. Deleting a thread also deletes its replies.</p>
        </header>

        <form method="get" asp-action="Discussions" class="toolbar">
            <label for="search" class="visually-hidden">Search threads</label>
            <input type="search" id="search" name="search" value="@ViewData["Search"]" placeholder="Search titles and text" />
            <button type="submit" class="btn btn-small">Search</button>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th scope="col">Thread</th><th scope="col">Course</th><th scope="col">Author</th><th scope="col">Replies</th><th scope="col">Posted</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-cell">No threads found.</td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><a class="text-link" asp-controller="Discussion" asp-action="Thread" asp-route-id="@p.PostId">@p.Title</a></td>
                            <td>@p.CourseTitle</td>
                            <td>@p.AuthorName</td>
                            <td>@p.ReplyCount</td>
                            <td>@p.CreatedAt.ToString("d MMM yyyy")</td>
                            <td class="actions">
                                <form asp-controller="Discussion" asp-action="Delete" asp-route-id="@p.PostId" method="post"
                                      data-confirm="Delete the thread &quot;@p.Title&quot; and its replies?">
                                    <input type="hidden" name="returnTo" value="admin" />
                                    <button type="submit" class="link-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model List<Course>
@{
    ViewData["Title"] = "Manage courses";
    var categories = ViewBag.Categories as List<Category> ?? new();
    var selected = ViewData["CategoryId"] as int?;
}

<div class="container admin-layout">
    <partial name="_AdminNav" />
    <div class="admin-main">
        <header class="admin-head with-action">
            <div>
                <h1>Courses</h1>
                <p>@Model.Count course(s) shown.</p>
            </div>
            <a class="btn btn-primary" asp-action="CreateCourse">Add course</a>
        </header>

        <form method="get" asp-action="Courses" class="toolbar">
            <label for="search" class="visually-hidden">Search courses</label>
            <input type="search" id="search" name="search" value="@ViewData["Search"]" placeholder="Search title or instructor" />
            <label for="categoryId" class="visually-hidden">Category</label>
            <select id="categoryId" name="categoryId">
                <option value="">All categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.CategoryId" selected="@(c.CategoryId == selected)">@c.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-small">Filter</button>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th scope="col">Course</th><th scope="col">Category</th><th scope="col">Level</th><th scope="col">Students</th><th scope="col">Content</th><th scope="col">Actions</th></tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-cell">No courses match this filter.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-with-thumb">
                                    <img src="@c.CoverImage" alt="" width="64" height="32" />
                                    <div><strong>@c.Title</strong><br /><small>@c.Instructor, @c.LessonCount lessons</small></div>
                                </div>
                            </td>
                            <td>@c.CategoryName</td>
                            <td><span class="level level-@c.Level.ToLower()">@c.Level</span></td>
                            <td>@c.EnrollmentCount</td>
                            <td>
                                <a class="text-link small" asp-action="Resources" asp-route-courseId="@c.CourseId">@c.ResourceCount resources</a><br />
                                <a class="text-link small" asp-action="Quizzes" asp-route-courseId="@c.CourseId">@c.QuizCount quizzes</a>
                            </td>
                            <td class="actions">
                                <a class="text-link" asp-controller="Courses" asp-action="Details" asp-route-id="@c.CourseId">View</a>
                                <a class="text-link" asp-action="EditCourse" asp-route-id="@c.CourseId">Edit</a>
                                <form asp-action="DeleteCourse" asp-route-id="@c.CourseId" method="post"
                                      data-confirm="Delete @c.Title? Its resources, quizzes, attempts, enrolments and discussions will also be deleted.">
                                    <button type="submit" class="link-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

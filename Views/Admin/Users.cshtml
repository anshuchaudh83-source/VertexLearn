@model List<User>
@{
    ViewData["Title"] = "Manage users";
    var search = ViewData["Search"] as string;
    var role = ViewData["Role"] as string;
    var me = User.GetUserId();
}

<div class="container admin-layout">
    <partial name="_AdminNav" />
    <div class="admin-main">
        <header class="admin-head with-action">
            <div>
                <h1>Users</h1>
                <p>@Model.Count account(s) shown.</p>
            </div>
            <a class="btn btn-primary" asp-action="CreateUser">Add user</a>
        </header>

        <form method="get" asp-action="Users" class="toolbar">
            <label for="search" class="visually-hidden">Search users</label>
            <input type="search" id="search" name="search" value="@search" placeholder="Search name or email" />
            <label for="role" class="visually-hidden">Role</label>
            <select id="role" name="role">
                <option value="">All roles</option>
                @foreach (var r in Roles.All)
                {
                    <option value="@r" selected="@(r == role)">@r</option>
                }
            </select>
            <button type="submit" class="btn btn-small">Filter</button>
        </form>

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Joined</th><th scope="col">Actions</th></tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-cell">No users match this filter.</td></tr>
                    }
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.FullName @if (u.UserId == me) { <small>(you)</small> }</td>
                            <td>@u.Email</td>
                            <td><span class="role role-@u.Role.ToLower()">@u.Role</span></td>
                            <td>@u.CreatedAt.ToString("d MMM yyyy")</td>
                            <td class="actions">
                                <a class="text-link" asp-action="EditUser" asp-route-id="@u.UserId">Edit</a>
                                @if (u.UserId != me)
                                {
                                    <form asp-action="DeleteUser" asp-route-id="@u.UserId" method="post"
                                          data-confirm="Delete @u.FullName? Their enrolments, quiz results and posts will also be deleted.">
                                        <button type="submit" class="link-danger">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

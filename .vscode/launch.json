{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (VertexLearn)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/VertexLearn.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  ]
}
